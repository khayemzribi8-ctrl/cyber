# ============================================================================
# Sentinel Security Assessment Platform — configuration
#
# EVERYTHING HERE IS OPTIONAL. The platform starts and runs fully offline with
# NO .env at all: web dashboard, audit engine, MITRE mapping, scoring, SQLite
# history, the network exposure scanner and HTML/CSV/JSON reports all work
# without any credentials. Fill in only the sections for integrations you use.
# ============================================================================

# --- Web app -----------------------------------------------------------------
# SECRET_KEY=change-me-to-a-long-random-string      # else a random key per boot
# PORT=5000
# PLATFORM_DB=./data/platform.db                    # SQLite history location
# ADMIN_PASSWORD=change-me                          # default admin password

# --- LDAP collector (optional; needs ldap3) ----------------------------------
LDAP_HOST=192.168.1.10
LDAP_PORT=389
LDAP_SSL=false
LDAP_BIND_DN=DOMAIN\Administrator
LDAP_BASE_DN=DC=example,DC=local
LDAP_PASSWORD=your_password_here

# --- Active Directory / Kerberos collectors (optional; needs ldap3) ----------
AD_HOST=192.168.1.10
AD_PORT=389
AD_DOMAIN=example.local
AD_BIND_DN=administrator@example.local
AD_PASSWORD=your_password_here

# --- SSH / Windows-over-SSH collectors (optional; needs paramiko) -------------
SSH_HOST=192.168.1.20
SSH_PORT=22
SSH_USERNAME=Administrator
SSH_PASSWORD=your_password_here
SSH_KEY_PATH=

# --- WinRM (optional; for remediation execution; needs pywinrm) --------------
WINRM_HOST=192.168.1.10
WINRM_USERNAME=Administrator
WINRM_PASSWORD=your_password_here

# --- AI advisory (optional; needs google-generativeai) -----------------------
GEMINI_API_KEY=

# --- AWS (ALL optional and OFF by default; never blocks startup) -------------
# Set the *_ENABLED flags to true only when you want these integrations.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DYNAMODB_ENABLED=false
DYNAMODB_TABLE=CyberAuditHistory
CLOUDWATCH_ENABLED=false
SNS_ENABLED=false
SNS_TOPIC_ARN=
