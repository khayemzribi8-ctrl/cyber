<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title>Rapport d'audit CyberAudit</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
  <div class="max-w-4xl mx-auto p-8 bg-white shadow-lg mt-10 rounded-lg">
    <h1 class="text-4xl font-bold text-center text-blue-800 mb-8">Rapport d'Audit CyberAudit</h1>
    <p class="text-center text-gray-600 mb-10">Généré le {{ generated_at }}</p>

    {% for section in sections %}
      <h2 class="text-2xl font-bold text-gray-800 mt-12 mb-6 border-b-2 border-gray-300 pb-2">{{ section.title }}</h2>
      {% if section.findings %}
        <div class="space-y-4">
          {% for finding in section.findings %}
            <div class="p-6 rounded-lg border-l-4
              {% if finding.severity == 'CRIT' %}border-red-600 bg-red-50
              {% elif finding.severity == 'WARN' %}border-yellow-600 bg-yellow-50
              {% elif finding.severity == 'INFO' %}border-blue-600 bg-blue-50
              {% else %}border-green-600 bg-green-50{% endif %}">
              <h3 class="font-bold text-lg">{{ finding.check }}</h3>
              <p class="mt-2"><strong>Gravité :</strong> 
                <span class="px-3 py-1 rounded text-white
                  {% if finding.severity == 'CRIT' %}bg-red-600
                  {% elif finding.severity == 'WARN' %}bg-yellow-600
                  {% elif finding.severity == 'INFO' %}bg-blue-600
                  {% else %}bg-green-600{% endif %}">
                  {{ finding.severity }}
                </span>
              </p>
              <p class="mt-2"><strong>Résultat :</strong> {{ finding.result }}</p>
              {% if finding.recommendation %}
                <p class="mt-3 text-sm italic text-gray-700"><strong>Recommandation :</strong> {{ finding.recommendation }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="text-gray-600 italic">Aucune vulnérabilité détectée dans ce module.</p>
      {% endif %}
    {% endfor %}

    <footer class="mt-16 text-center text-gray-500 text-sm">
      Rapport généré par CyberAudit — Ghassen Tekaya — 2025
    </footer>
  </div>
</body>
</html>